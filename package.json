{
  "name": "@civ-clone/base-unit-action-poison-water",
  "version": "0.1.0",
  "description": "The PoisonWater unit action: a Spy poisons a city's water supply, with criteria for offering it.",
  "repository": "git@github.com:civ-clone/base-unit-action-poison-water.git",
  "keywords": [
    "typescript",
    "civilization"
  ],
  "author": "dom111 <dom111@users.noreply.github.com>",
  "license": "MIT",
  "private": false,
  "files": [
    "*.ts",
    "*.js",
    "*.js.map",
    "lib/**/*.ts",
    "lib/**/*.js",
    "lib/**/*.js.map",
    "Rules/**/*.ts",
    "Rules/**/*.js",
    "Rules/**/*.js.map",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "npm run ts:compile && npm run prettier:format",
    "prettier:check": "prettier --config .prettierrc --check '**/*.ts'",
    "prettier:format": "prettier --config .prettierrc '**/*.ts' --write",
    "test": "ts-mocha ./tests/*.test.ts",
    "ts:compile": "tsc --build tsconfig.json"
  },
  "devDependencies": {
    "@civ-clone/core-terrain": "^0.1.4",
    "@types/chai": "^4.0.0",
    "@types/mocha": "^10.0.0",
    "@types/node": "^16.0.0",
    "chai": "^4.0.0",
    "mocha": "^10.0.0",
    "prettier": "^2.8.8",
    "ts-mocha": "^10.0.0",
    "typescript": "^4.0.0",
    "@civ-clone/core-player": "^0.1.10"
  },
  "dependencies": {
    "@civ-clone/base-unit-agent": "^0.1.0",
    "@civ-clone/core-city": "^0.1.25",
    "@civ-clone/core-rule": "^0.1.9",
    "@civ-clone/core-unit": "^0.1.32",
    "@civ-clone/core-world": "^0.1.24"
  }
}
